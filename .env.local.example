# Copy to .env.local, edit installation paths, and source from the project root.
# The real .env.local is ignored; no private keys belong in this template.
export MULTI_MCU_REPO_ROOT="$PWD"
export MULTI_MCU_ARM_TOOLCHAIN_ROOT="$HOME/toolchains/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi"
export STM32_TOOLCHAIN_PATH="$MULTI_MCU_ARM_TOOLCHAIN_ROOT"
export STM32_CUBE_CLT_PATH="$HOME/st/stm32cubeclt_1.22.0"
export ZEPHYR_SDK_INSTALL_DIR="$HOME/toolchains/zephyr-sdk-1.0.1"
export ZEPHYR_TOOLCHAIN_VARIANT=zephyr
export NCS_ROOT="$MULTI_MCU_REPO_ROOT/.ncs-workspace/nrf"
export ZEPHYR_BASE="$MULTI_MCU_REPO_ROOT/.ncs-workspace/zephyr"
export CCACHE_DIR="$MULTI_MCU_REPO_ROOT/.cache/ccache"
export PATH="$MULTI_MCU_REPO_ROOT/.venv/bin:$MULTI_MCU_ARM_TOOLCHAIN_ROOT/bin:$STM32_CUBE_CLT_PATH/STM32CubeProgrammer/bin:$PATH"
