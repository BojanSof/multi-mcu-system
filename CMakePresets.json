{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Native debug tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [{ "name": "native-debug", "configurePreset": "native-debug" }],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true } }
  ]
}
