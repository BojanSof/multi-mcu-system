#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		multi-mcu,node-uart = &uart21;
	};

	zephyr,user {
		node-irq-gpios = <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		node-ready-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		host-debug-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	host_console_default: host_console_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	host_console_sleep: host_console_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};

	host_uart_default: host_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 12)>;
			bias-pull-up;
		};
	};

	host_uart_sleep: host_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>,
				<NRF_PSEL(UART_RX, 1, 12)>;
			low-power-enable;
		};
	};
};

&uart20 {
	pinctrl-0 = <&host_console_default>;
	pinctrl-1 = <&host_console_sleep>;
};

&uart21 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&host_uart_default>;
	pinctrl-1 = <&host_uart_sleep>;
	pinctrl-names = "default", "sleep";
};
